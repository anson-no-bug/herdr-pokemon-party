{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "theme": {
    "light": "herdr-pokemon",
    "dark": "herdr-pokemon-night"
  },
  "background": "canvas",
  "terminal_padding": [14, 12],
  "terminal_line_height": 1.15,
  "preview": "layouts/herdr-pokemon.svg",
  "toast": "herdr-pokemon",
  "terminal_menu": "herdr-pokemon",
  "link_handlers": ["herdr-pokemon"],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 272 },
      "min": 48,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": {
            "mod": "herdr-pokemon",
            "props": { "role": "brand" }
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": { "weight": 1 },
              "min": 96,
              "content": {
                "mod": "herdr-pokemon",
                "props": { "role": "spaces" }
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": { "weight": 1 },
              "min": 96,
              "content": {
                "mod": "herdr-pokemon",
                "props": { "role": "agents" }
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": { "px": 44 },
          "content": {
            "mod": "herdr-pokemon",
            "props": { "role": "footer" }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 44 },
          "window_drag": true,
          "content": {
            "mod": "herdr-pokemon",
            "props": { "role": "tabs" }
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 0,
          "gap": 1,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 1,
                  "radius": 0,
                  "background": "background",
                  "lone": false,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "herdr-pokemon",
                      "props": { "role": "pane" }
                    },
                    "height": 32,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "herdr-pokemon",
                        "props": { "role": "files" }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "herdr-pokemon",
                        "props": { "role": "changes" }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "pokemon-habitat",
          "type": "block",
          "size": { "px": 232 },
          "min": 232,
          "max": 232,
          "content": {
            "mod": "herdr-pokemon",
            "props": { "role": "habitat" }
          }
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 36 },
          "content": {
            "mod": "herdr-pokemon",
            "props": { "role": "status" }
          }
        }
      ]
    }
  ]
}
